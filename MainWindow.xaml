<Window x:Class="AboutMeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AboutMeApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="39*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- This is Grid Row "0"-->
            <RowDefinition Height="*"/>
            <!-- This is Grid Row "1"-->
        </Grid.RowDefinitions>
        <TextBlock Text="About Me" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="347,0,0,0"/>
        <!-- This is Grid Row 0 -->
        <StackPanel Grid.Row="1" Margin="20,20,20,20" Grid.ColumnSpan="2">
            <TextBlock Text="Name"/>
            <TextBlock Text="Lucas Ruiz"/>
            <TextBlock Text="Hobby:" Margin="0,10,0,0   "/>
            <TextBlock Text="Playing games"/>
            <TextBlock Text="Favorite Color:" Margin="0,10,0,0   "/>
            <TextBlock Text="Blue"/>
            <Image Source="path_to_your_image.jpg" Height="100" Margin="0,0,0,10"/>
        </StackPanel>
    </Grid>
</Window>
